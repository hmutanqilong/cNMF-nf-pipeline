nextflow.enable.dsl=2

profiles{

    local {
        // ---- local laptop/desktop profile ----
    }

    hpc {
        //executor setting
        executor {
            name = 'slurm'
            queueSize = 1000
            submitRateLimit = '5 sec'
        }

        // basic process options
        process {
            // Slurm options
            executor = 'slurm'
            
            //queue = 'xuanyao-hm'
            clusterOptions = '--account pi-xuanyao'
            
            // resourses
            cpus = 1
            memory = '20 GB'
            // errorStrategy = 'retry'
            // maxRetries = 2
            
            // run script in login shell
            shell=['/bin/bash','-l']
            
            // some beforeScript settings
            beforeScript = 
            '''
            echo "------ loading conda and env -------"
            module load miniconda3-3.11.1
            source activate cNMF

            chmod u+x .command.sh

            '''

            /* ----------------- some specific options in process ----------------------*/
            // step 1: prepare_initial
            withName:prepare_initial {
                errorStrategy = 'retry'
                maxRetries = 2
                cpus = 1
                clusterOptions = '--account pi-xuanyao -p xuanyao-hm --qos xuanyao --nodelist midway3-0316'
                // queue = 'caslake'
                memory = {task.attempt > 1 ? '400 GB' : '300 GB'}
                time = '2h'
            }

            // step 2: prepare generalize
            withName:prepare_generalized {
                cpus = 1
                //queue = 'caslake'
                clusterOptions = '--account pi-xuanyao -p xuanyao-hm --qos xuanyao --nodelist midway3-0316'
                memory = '10 GB'
                time = '2h'
            }

            // step 3: factorize
            withName:factorize_worker {
                errorStrategy = 'retry'
                maxRetries = 2
                cpus = 1
                // queue = 'caslake'
                clusterOptions = '--account pi-xuanyao -p xuanyao-hm --qos xuanyao --nodelist midway3-0316'
                memory = {task.attempt > 1 ? '30 GB' : '20 GB'}
                time = '35h'
            }
            
            withName:factorize_complete {
                cpus = 1
                // queue = 'caslake'
                clusterOptions = '--account pi-xuanyao -p xuanyao-hm --qos xuanyao --nodelist midway3-0316'
                memory = '2.GB'
                time = '2h'    
            
            }

            withName:check_and_repair_factorize {
                errorStrategy = 'retry'
                maxRetries = 2
                clusterOptions = '--account pi-xuanyao -p xuanyao-hm --qos xuanyao --nodelist midway3-0316'
                memory = {task.attempt > 1 ? '40 GB' : '30 GB'}
                time = '35h'           
            }

            // step 4: combine
            withName:combine_results{
                errorStrategy = 'retry'
                maxRetries = 2
                // queue = 'caslake'
                clusterOptions = '--account pi-xuanyao -p xuanyao-hm --qos xuanyao --nodelist midway3-0316'
                cpus = 1
                memory = {task.attempt > 1 ? '100 GB' : '50 GB'}
                time = '5h'
            }

            // step 5: kplot
            withName:kplot {
                // queue = 'caslake'
                clusterOptions = '--account pi-xuanyao -p xuanyao-hm --qos xuanyao --nodelist midway3-0316'
                cpus = 1
                memory = '90 GB'
                time = '2h'
            }

        }
            
        
    }
}
